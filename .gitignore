# .gitignore - Files to exclude from git

# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Turbo
.turbo/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Environment files
.env
.env.local
.env.*.local

# Turbo cache
.turbo/

# Generated docs
docs/api/

# Misc
*.tgz
.nyc_output/

# Vite
dist-ssr/
*.local

# TypeScript cache
*.tsbuildinfo

# vitest
vitest.config.ts.timestamp-*.map

# .oficina (runtime state)
.oficina/

# Traits (runtime)
traits/

# Benchmarks submodules
benchmarks/proof-of-value/tasks/*/ky-repo/
benchmarks/proof-of-value/tasks/*/parse-json-repo/
benchmarks/proof-of-value/tasks/*/type-fest-repo/

# Private keys and secrets
*.pem
*.key
*.crt

# IDE/Editor
*.swp
*.swo
*~

# Local development
.local/
*.local