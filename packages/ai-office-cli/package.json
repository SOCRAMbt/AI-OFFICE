{
    "name": "ai-office-cli",
    "version":  "4.0.0",
    "description":  "AI-OFFICE Unified CLI",
    "type":  "module",
    "main":  "./dist/index.js",
    "files":  ["dist", "README.md", "LICENSE"],
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "bin":  {
                "ai-office":  "./dist/index.js"
            },
    "scripts":  {
                    "build":  "tsc -p tsconfig.build.json",
                    "dev":  "tsc -p tsconfig.build.json --watch",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest"
                },
    "dependencies":  {
                         "ai-office-core": "^4.0.0",
                         "chalk":  "^6.0.1",
                         "commander":  "^15.1.0",
                         "inquirer":  "^14.3.1",
                         "ora":  "^10.0.0"
                     },
    "devDependencies":  {
                            "@types/inquirer":  "^10.0.0",
                            "@types/node":  "^26.6.6",
                            "typescript":  "^7.0.2",
                            "vitest":  "^5.0.5"
                        },
    "publishConfig":  {
                          "access":  "public"
                      }
}








