{
    "name": "ai-office-host-codex",
    "version":  "4.0.0",
    "description":  "Codex Host Adapter for AI-OFFICE",
    "type":  "module",
    "main":  "./dist/CodexAdapter.js",
    "types":  "./dist/CodexAdapter.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/CodexAdapter.d.ts",
                              "import":  "./dist/CodexAdapter.js"
                          }
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.build.json",
                    "dev":  "tsc -p tsconfig.build.json --watch",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest"
                },
    "dependencies":  {
                         "ai-office-core": "^4.0.0",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "@types/node":  "^26.6.6",
                            "typescript":  "^7.0.2",
                            "vitest":  "^5.0.5"
                        },
    "publishConfig":  {
                          "access":  "public"
                      }
}







