{
    "name": "ai-office-host-opencode",
    "version":  "4.0.0",
    "description":  "OpenCode Host Adapter for AI-OFFICE",
    "type":  "module",
    "main":  "./dist/OpenCodeAdapter.js",
    "files":  ["dist", "README.md", "LICENSE"],
    "types":  "./dist/OpenCodeAdapter.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/OpenCodeAdapter.d.ts",
                              "import":  "./dist/OpenCodeAdapter.js"
                          }
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.build.json",
                    "dev":  "tsc -p tsconfig.build.json --watch",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest"
                },
    "dependencies":  {
                         "ai-office-core": "^4.0.0",
                         "zod":  "^4.6.7"
                     },
    "peerDependencies":  {
                             "@opencode-ai/plugin":  "^1.15.11"
                         },
    "peerDependenciesMeta":  {
                                 "@opencode-ai/plugin":  {
                                                             "optional":  true
                                                         }
                             },
    "devDependencies":  {
                            "@opencode-ai/plugin":  "^1.19.5",
                            "@opencode/plugin":  "^2.3.2",
                            "@types/node":  "^26.6.6",
                            "typescript":  "^6.0.3",
                            "vitest":  "^5.0.5"
                        },
    "publishConfig":  {
                          "access":  "public"
                      }
}







