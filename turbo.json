{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tsbuildinfo"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "coverage": {
      "dependsOn": ["^test"],
      "cache": true
    },
    "docs:check": {
      "dependsOn": ["^build"],
      "cache": true
    }
  },
  "globalDependencies": [".env*"],
  "globalEnv": ["NODE_ENV", "CI"]
}