{
  "name": "oficina-opencode",
  "version": "3.0.5",
  "description": "Oficina de Agents — malla de coordinadores + peer mesh para OpenCode. Orquestación durable de subagentes con bus de mensajes en disco, roster de roles, leases, gates de calidad y escalamiento por invariantes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/v2.js",
  "types": "./dist/v2.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "oficina": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "commands",
    "docs",
    "examples",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-agent",
    "agents",
    "orchestration",
    "multi-agent",
    "agent-mesh",
    "peer-to-peer",
    "durable-execution",
    "workflow",
    "state-machine",
    "cli",
    "ai"
  ],
  "author": "SOCRAMbt <noreply@github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOCRAMbt/AI-OFFICE.git"
  },
  "homepage": "https://github.com/SOCRAMbt/AI-OFFICE#readme",
  "bugs": {
    "url": "https://github.com/SOCRAMbt/AI-OFFICE/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "npm run build && vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run docs:check",
    "docs:sync": "tsx scripts/sync-docs.ts",
    "docs:check": "tsx scripts/sync-docs.ts --check",
    "bench:selection": "tsx benchmarks/selection/run.ts",
    "diagnose": "tsx scripts/diagnose-run.ts"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.15.11"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.5",
    "@opencode/client": "^2.1.2",
    "@opencode/plugin": "^2.1.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "toml": "^5.0.1",
    "effect": "^4.0.0-rc.118"
  }
}
