{
  "name": "oficina-opencode",
  "version": "2.0.0",
  "description": "Oficina de Agents — malla de coordinadores + peer mesh para OpenCode. Orquestación durable de subagentes con bus de mensajes en disco, roster de roles, leases, gates de calidad y escalamiento por invariantes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "oficina": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "commands",
    "docs",
    "examples",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-agent",
    "agents",
    "orchestration",
    "multi-agent",
    "agent-mesh",
    "peer-to-peer",
    "durable-execution",
    "workflow",
    "state-machine",
    "cli",
    "ai"
  ],
  "author": "Marcos <casselsmarcos1@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOCRAMbt/El-ltimoTPP.git"
  },
  "homepage": "https://github.com/SOCRAMbt/El-ltimoTPP#readme",
  "bugs": {
    "url": "https://github.com/SOCRAMbt/El-ltimoTPP/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "npm run build && vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.15.11",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
